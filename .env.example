# Local development configuration. Values below are non-production, local-demo only.
APP_ENV=local
LOG_LEVEL=info
API_PORT=3000
CONSOLE_PORT=5173
CONSOLE_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/pirh-local
VITE_OIDC_CLIENT_ID=pirh-console
AWS_REGION=us-east-1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DYNAMODB_ENDPOINT=http://localhost:8000
ELASTICMQ_ENDPOINT=http://localhost:9324
CORE_TABLE_NAME=pirh-core-local
AUDIT_TABLE_NAME=pirh-audit-local
OIDC_ISSUER=http://localhost:8080/realms/pirh-local
OIDC_AUDIENCE=pirh-console
LOCAL_SECRET_MASTER_KEY_B64=<base64-encoded-32-byte-local-only-key>
LOCAL_SEED_PRODUCER_SECRET=<local-only-producer-secret>
LOCAL_SEED_ALPHA_API_KEY=<local-only-alpha-api-key>
LOCAL_SEED_BETA_CLIENT_SECRET=<local-only-beta-client-secret>
LOCAL_SEED_TARGET_ALPHA_API_KEY=<different-local-only-target-alpha-api-key>
LOCAL_SEED_TARGET_BETA_CLIENT_SECRET=<different-local-only-target-beta-client-secret>
LOCAL_CURSOR_SECRET=<local-only-cursor-signing-secret>
PORTABILITY_PLAN_SIGNING_KEY_B64=<base64-encoded-32-byte-local-only-plan-signing-key>
MOCK_CONTROL_TOKEN=<local-only-mock-control-token>
# Keycloak local-demo identities are defined in infrastructure/docker/keycloak/.
# admin@example.test / admin-demo-only
# operator@example.test / operator-demo-only
# viewer@example.test / viewer-demo-only
# target-admin@example.test / target-admin-demo-only
# Never reuse those local-demo passwords or place real credentials in this file.
