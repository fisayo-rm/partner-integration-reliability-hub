FROM node:24.11.1-alpine3.21 AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json tsconfig.build.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY eslint.config.mjs vitest.config.ts playwright.config.ts ./
ARG VITE_API_BASE_URL=http://localhost:3000
ARG VITE_OIDC_AUTHORITY=http://localhost:8080/realms/pirh-local
ARG VITE_OIDC_CLIENT_ID=pirh-console
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
RUN pnpm install --frozen-lockfile && pnpm --filter @pirh/contracts build && pnpm --filter @pirh/console build

FROM nginx:1.27.2-alpine
COPY infrastructure/docker/console.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/console/dist /usr/share/nginx/html
