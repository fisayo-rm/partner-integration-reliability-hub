{
  "realm": "pirh-local",
  "enabled": true,
  "displayName": "Partner Integration Reliability Hub Local",
  "roles": {
    "realm": [{ "name": "admin" }, { "name": "operator" }, { "name": "viewer" }]
  },
  "clients": [
    {
      "clientId": "pirh-console",
      "name": "PIRH local console",
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "pirh-console audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "pirh-console",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
