{
  "name": "partner-integration-reliability-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.18.2"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "typecheck": "tsc --build tsconfig.build.json",
    "architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "secret:scan": "node scripts/scan-secrets.mjs",
    "audit": "pnpm audit --audit-level high",
    "local:up": "docker compose --env-file .env.local up --build",
    "local:up:observability": "docker compose --env-file .env.local --profile observability up --build",
    "local:down": "docker compose down --volumes --remove-orphans",
    "local:verify": "node scripts/verify-local-platform.mjs",
    "demo:m04": "node scripts/demo-m04.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture && pnpm test && pnpm build && pnpm secret:scan && pnpm audit"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1111.0",
    "@aws-sdk/lib-dynamodb": "3.1111.0",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.1",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "fastify": "5.8.5",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vitest": "3.2.6",
    "yaml": "2.8.3"
  }
}
